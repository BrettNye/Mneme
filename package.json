{
  "name": "mneme",
  "type": "module",
  "bin": {
    "mneme": "./bin/mneme.ts",
    "mneme-mcp": "./bin/mneme-mcp.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./surface": "./src/surface/index.ts",
    "./cli": "./src/cli/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./audit": "./src/audit/index.ts",
    "./audit/aws": "./src/audit/aws/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/quickstart.ts",
    "example:bio": "tsx examples/bio-quickstart.ts",
    "mneme": "tsx bin/mneme.ts",
    "mneme-mcp": "tsx bin/mneme-mcp.ts",
    "eval:lme": "tsx bench/longmemeval/run.ts --raw --file bench/datasets/longmemeval/longmemeval_s.json --claims bench/datasets/longmemeval/longmemeval-claims.jsonl",
    "eval:lme:extract": "tsx bench/convert/longmemeval.ts --in bench/datasets/longmemeval/longmemeval_s.json --out bench/datasets/longmemeval/longmemeval-claims.jsonl",
    "eval:lme:fixture": "tsx bench/longmemeval/run.ts --file bench/longmemeval/fixtures/dataset.json --claims bench/longmemeval/fixtures/claims.jsonl",
    "pressure": "npm run pressure:corpus-identity && npm run pressure:multitenant && npm run pressure:adversarial && npm run pressure:tamper && npm run pressure:concurrent && npm run pressure:crash",
    "pressure:corpus-identity": "tsx bench/pressure/corpus-identity.ts",
    "pressure:multitenant": "tsx bench/pressure/multitenant.ts",
    "pressure:adversarial": "tsx bench/pressure/adversarial.ts",
    "pressure:tamper": "tsx bench/pressure/tamper.ts",
    "pressure:concurrent": "tsx bench/pressure/concurrent.ts",
    "pressure:crash": "tsx bench/pressure/crash.ts",
    "pressure:migration": "tsx bench/pressure/migration.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "*",
    "@aws-sdk/client-kms": "*"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": { "optional": true },
    "@aws-sdk/client-kms": { "optional": true }
  }
}
